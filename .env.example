# Public URL (used for metadata, sitemap and OG images)
NEXT_PUBLIC_SITE_URL=https://nextbase-gsap.vercel.app

# microCMS
MICROCMS_SERVICE_DOMAIN=
MICROCMS_API_KEY=
# Optional: secret for the microCMS webhook (app/api/revalidate/route.ts)
MICROCMS_WEBHOOK_SECRET=

# Contact form (Server Action: app/actions/contact.ts)
CONTACT_TO_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# reCAPTCHA v3 (optional)
RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
